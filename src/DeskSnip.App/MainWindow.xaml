<local:ProductWindow x:Class="DeskSnip.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DeskSnip.App"
        Title="DeskSnip"
        Width="1020" Height="700" MinWidth="900" MinHeight="580" WindowStartupLocation="CenterScreen">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,24">
            <WrapPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="560">
                <Button Content="{local:Text Source='设置'}" Click="SettingsClick" Margin="3"/>
                <Button Content="{local:Text Source='长截图'}" Click="LongClick" Margin="3"/>
                <Button Content="{local:Text Source='截图预设'}" Click="PresetClick" Margin="3"/>
                <Button Content="{local:Text Source='录制恢复'}" Click="RecordingRecoveryClick" Margin="3"/>
                <Button Content="{local:Text Source='收起到托盘'}" Click="TrayClick" Margin="3"/>
            </WrapPanel>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Image Source="{x:Static local:Branding.Image}" Width="38" Height="38" Margin="0,0,12,0"/>
                    <TextBlock Text="DeskSnip" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
                </StackPanel>
                <TextBlock Text="{local:Text Source='截图、标注、钉图，让桌面信息随手可用。'}" Foreground="{DynamicResource SubtleBrush}" Margin="50,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>
        <UniformGrid Grid.Row="1" Columns="3" Margin="-5,0,-5,18">
            <Button Click="CaptureClick" AutomationProperties.Name="{local:Text Source='截取屏幕'}" Margin="5" Padding="18,17" Background="{DynamicResource AccentBrush}" Foreground="White" BorderBrush="{DynamicResource AccentBrush}">
                <StackPanel HorizontalAlignment="Left"><TextBlock Text="{local:Text Source='截取屏幕'}" FontSize="20" FontWeight="SemiBold" Foreground="White"/><TextBlock x:Name="CaptureKey" Text="{local:Text Source='Ctrl+Alt+A · 框选、复制与编辑'}" Margin="0,8,0,0" Opacity="0.85" Foreground="White" TextWrapping="Wrap"/></StackPanel>
            </Button>
            <Button Click="ClipboardClick" AutomationProperties.Name="{local:Text Source='钉住剪贴板'}" Margin="5" Padding="18,17">
                <StackPanel HorizontalAlignment="Left"><TextBlock Text="{local:Text Source='钉住剪贴板'}" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="PinKey" Text="{local:Text Source='Ctrl+Alt+P · 图片贴到桌面'}" Foreground="{DynamicResource SubtleBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel>
            </Button>
            <Button Click="RecordClick" AutomationProperties.Name="{local:Text Source='录制区域'}" Margin="5" Padding="18,17">
                <StackPanel HorizontalAlignment="Left"><TextBlock Text="{local:Text Source='录制区域'}" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="RecordKey" Text="Ctrl+Alt+R · MP4 / GIF" Foreground="{DynamicResource SubtleBrush}" Margin="0,8,0,0"/></StackPanel>
            </Button>
        </UniformGrid>
        <Border x:Name="NoticeBox" Grid.Row="2" Background="{DynamicResource NoticeBrush}" CornerRadius="7" Padding="12" Margin="0,0,0,14" Visibility="Collapsed">
            <TextBlock x:Name="Notice" Foreground="{DynamicResource NoticeInkBrush}" TextWrapping="Wrap"/>
        </Border>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
            <Border Background="{DynamicResource PanelBrush}" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="18">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Button Content="{local:Text Source='打开图片…'}" Click="OpenClick" DockPanel.Dock="Right" Padding="12,5"/>
                        <StackPanel><TextBlock Text="{local:Text Source='最近记录'}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{local:Text Source='截图和录屏保存在本机'}" Foreground="{DynamicResource SubtleBrush}" FontSize="12" Margin="0,4,0,0"/></StackPanel>
                    </DockPanel>
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <Button Content="{local:Text Source='打开 / 编辑'}" Click="HistoryOpenClick" Padding="12,6" Margin="0,0,5,0"/>
                        <Button Content="{local:Text Source='钉图'}" Click="HistoryPinClick" Padding="12,6" Margin="0,0,5,0"/>
                        <Button Content="{local:Text Source='另存为…'}" Click="HistorySaveClick" Padding="12,6"/>
                        <Button Content="{local:Text Source='导出 GIF'}" Click="HistoryGifClick" Padding="12,6" Margin="5,0,0,0"/>
                        <Button Content="{local:Text Source='文字识别'}" Click="HistoryOcrClick" Padding="12,6" Margin="5,0,0,0"/>
                        <Button Content="{local:Text Source='联网识别'}" Click="HistoryServiceClick" Padding="12,6" Margin="5,0,0,0"/>
                    </WrapPanel>
                    <Grid>
                        <ListBox x:Name="HistoryList" BorderThickness="0" MouseDoubleClick="HistoryDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="8,11"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
                        </ListBox>
                        <TextBlock x:Name="EmptyHistory" Text="{local:Text Source='从一次截图开始。&#10;框选、标注，再复制或钉到桌面。'}" Foreground="{DynamicResource SubtleBrush}" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="25" TextWrapping="Wrap"/>
                    </Grid>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Background="{DynamicResource PinPanelBrush}" CornerRadius="12" Padding="18">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="{local:Text Source='桌面钉图'}" FontSize="17" FontWeight="SemiBold"/>
                        <Button Content="{local:Text Source='分组与批量管理'}" Click="PinManagerClick" Margin="0,8,0,0"/>
                        <TextBlock Text="{local:Text Source='滚轮缩放 · Ctrl+滚轮调透明度&#10;右键管理 · 拖动移动'}" Foreground="{DynamicResource SubtleBrush}" FontSize="12" Margin="0,8,0,12" LineHeight="21" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <Button Content="{local:Text Source='显示 / 隐藏全部钉图'}" Click="TogglePinsClick" Margin="0,0,0,7"/>
                        <Button Content="{local:Text Source='解除全部穿透 / 锁定'}" Click="RecoverClick" Margin="0,0,0,7"/>
                        <Button x:Name="RestoreButton" Content="{local:Text Source='恢复最近关闭的钉图'}" Click="RestoreClick" IsEnabled="False"/>
                    </StackPanel>
                    <ListBox x:Name="PinList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="5,8"/></Style></ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
        <DockPanel Grid.Row="4" Margin="0,18,0,0">
            <Button Content="{local:Text Source='退出'}" Click="ExitClick" DockPanel.Dock="Right" Padding="12,5" MinHeight="30"/>
            <Button Content="{local:Text Source='恢复识别结果'}" Click="RecognitionRestoreClick" DockPanel.Dock="Right" Padding="12,5" Margin="5,0"/>
            <Button Content="{local:Text Source='联网识别 / 翻译'}" Click="RecognitionServiceClick" DockPanel.Dock="Right" Padding="12,5" Margin="5,0"/>
            <TextBlock x:Name="Footer" Text="{local:Text Source='本地处理 · Windows 桌面工具'}" Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Center" FontSize="12"/>
        </DockPanel>
    </Grid>
</local:ProductWindow>
