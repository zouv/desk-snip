<Project>
  <PropertyGroup>
    <!-- 目标框架唯一出处：init.sh 按参数或本机 SDK 决定。UI 项目用 WindowsTfm，Core / Tests 用 BaseTfm。 -->
    <WindowsTfm>net48</WindowsTfm>
    <BaseTfm>net48</BaseTfm>

    <!-- 版本号唯一出处：exe / zip 文件名 / 程序集版本都读它。 -->
    <Version>0.4.1</Version>
    <Authors>DeskSnip contributors</Authors>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- NuGet 漏洞公告随时间新增：不让「代码没动」的构建因它变红，仍以警告显示。 -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
